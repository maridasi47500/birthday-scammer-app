<div id="<%= dom_id post %>">
  <div>
    <strong>User:</strong>
    <%= post.user_id %>
  </div>

  <div>
    <strong>Pic:</strong>
    <%= post.pic %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= post.title %>
  </div>

  <div>
    <strong>Content:</strong>
    <%= post.content %>
  </div>

  <div>
    <strong>Socialmedia:</strong>
    <%= post.socialmedia_id %>
  </div>

</div>
