<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%=session.as_json%>
    <%=authenticated?.try(:user).as_json%>
    <%= form.label :user_id, style: "display: block" %>
    <%= form.hidden_field :user_id, value: "" %>
  </div>

  <div>
    <%= form.label :pic, style: "display: block" %>
    <%= form.file_field :pic %>
  </div>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.text_field :content %>
  </div>

  <div>
    <%= form.label :socialmedia_id, style: "display: block" %>
    <%= form.collection_select :socialmedia_id, Socialmedia.all, :id, :name %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
